# Copie ce fichier en `.env` et renseigne tes valeurs Supabase.
# Sans ces deux variables, Kora affiche un écran « Configuration requise » (aucun mode démo).

VITE_SUPABASE_URL=https://ton-projet.supabase.co
VITE_SUPABASE_ANON_KEY=ta-cle-anon-publishable

# Optionnel : adresse affichée sur la page /contact
# VITE_CONTACT_EMAIL=contact@example.com

# Optionnel : clé gratuite Tenor pour l'onglet GIF du sélecteur médias.
# Sans elle, l'onglet GIF affiche un message honnête (aucun GIF simulé).
# Obtenir une clé : console Google Cloud → activer l'API Tenor → créer une clé API.
# VITE_TENOR_API_KEY=ta-cle-tenor
